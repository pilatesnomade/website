---
import { Image, inferRemoteSize } from "astro:assets";
import { storyblokEditable } from "@storyblok/astro";
import StoryblokComponent from "@storyblok/astro/StoryblokComponent.astro";
import RichTextRenderer from "storyblok-rich-text-astro-renderer/RichTextRenderer.astro";
import Heading from "../helpers/Heading.astro";

const { blok } = Astro.props;

const cardsWithFocal = await Promise.all(
  blok.cards.map(async (card) => {
    if (!card.image?.id) {
      return { card, focalX: 50, focalY: 50, width: 0, height: 0 };
    }

    const [posX = "50", posY = "50"] = (card.image.focus || "50x50").split("x");
    const { width = 1, height = 1 } = await inferRemoteSize(card.image.filename);

    const focalX = (parseInt(posX) / width) * 100;
    const focalY = (parseInt(posY) / height) * 100;

    return { card, focalX, focalY, width, height };
  })
);

console.log(cardsWithFocal.map(({ card }) => card.url));
---

<section
  {...storyblokEditable(blok)}
  data-stacking-cards-init=""
  data-stacking-cards-desktop="true"
  data-stacking-cards-tablet="true"
  data-stacking-cards-mobile="true"
  class="cards-stack">
  <div class="container">
    <div class="cards-stack__collection">
      <div data-stacking-card-stack="" class="cards-stack__list">
        {
          cardsWithFocal.map(({ card, focalX, focalY, width, height }) => (
            <a
              href={`
                ${
                  card.url.url == ""
                    ? `/${card.url?.story?.full_slug === "home" ? "" : card.url?.story?.full_slug || "#"}`
                    : card.url.url
                }/`}
              data-stacking-card=""
              class="cards-stack__item is--wide">
              <div data-stacking-card-target="" class={`cards-stack-card is--wide ${card.color}`}>
                <div class="cards-stack-card__start pb-8">
                  <Heading tag={blok.tag || "p"} class="cards-stack-card__number text-inherit">
                    {card?.title}
                  </Heading>
                </div>
                {card.description && (
                  <div class={`text-container-base mb-8 px-0 text-inherit`}>
                    <RichTextRenderer
                      content={card.description}
                      resolver={(blok) => {
                        return {
                          component: StoryblokComponent,
                          props: { blok }
                        };
                      }}
                    />
                  </div>
                )}
                <div class="cards-stack-card__end">
                  <Image
                    src={card.image?.filename}
                    alt={card.image?.alt}
                    class="focal max-h-72 w-full rounded-xl object-cover"
                    width={width}
                    height={height}
                    layout="constrained"
                    style={`--focalPointX: ${focalX}; --focalPointY: ${focalY};`}
                  />
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .cards-stack {
    padding-top: 5dvh;
    padding-bottom: 15dvh;
  }

  .focal {
    object-position: calc(var(--focalPointY) * 1%) calc(var(--focalPointY) * 1%);
  }

  .container {
    max-width: 90em;
    margin-left: auto;
    margin-right: auto;
    padding-left: 2em;
    padding-right: 2em;
  }

  .cards-stack__list {
    grid-column-gap: 5em;
    grid-row-gap: 5em;
    flex-flow: column;
    justify-content: center;
    align-items: center;
    width: 100%;
    display: flex;
  }

  .cards-stack__item {
    flex: none;
    width: 100%;
    max-width: 25em;
    position: sticky;
    top: 5em;
  }

  .cards-stack__item.is--wide {
    max-width: 80em;
  }

  .cards-stack-card {
    background-color: var(--color-pastel);
    border-radius: 2em;
    flex-flow: column;
    justify-content: space-between;
    width: 100%;
    padding: 2.5em;
    display: flex;
  }

  .cards-stack-card.corail {
    background-color: var(--color-corail);
    color: var(--color-marron);
  }

  .cards-stack-card.marron {
    background-color: var(--color-marron);
    color: white;
  }

  .cards-stack-card.jaune {
    background-color: var(--color-jaune);
    color: var(--color-marron);
  }

  .cards-stack-card.atoll {
    background-color: var(--color-atoll);
    color: white;
  }

  .cards-stack-card.lavande {
    background-color: var(--color-lavande);
    color: white;
  }

  .cards-stack-card.pastel {
    background-color: var(--color-pastel);
    color: var(--color-marron);
  }

  .cards-stack-card.is--wide {
  }

  .cards-stack-card__number {
    font-size: 4em;
    font-weight: 500;
    line-height: 0.95;
  }

  .cards-stack-card__h {
    letter-spacing: -0.04em;
    margin-top: 0;
    margin-bottom: 0;
    font-size: 3.375em;
    font-weight: 600;
    line-height: 0.95;
  }

  .cards-stack-card__h.is--wide {
    font-size: 4.5em;
  }

  .cards-stack-card__services {
    flex-flow: column;
    justify-content: flex-end;
    min-height: 11em;
    display: flex;
  }

  .cards-stack-card__services-p {
    letter-spacing: -0.01em;
    margin-bottom: 0;
    font-size: 1.125em;
    font-weight: 500;
    line-height: 1.4;
  }

  @media screen and (max-width: 991px) {
    .cards-stack-card.is--wide {
      aspect-ratio: 5 / 4;
    }
    .cards-stack-card__number {
      font-size: 4em;
    }
  }

  @media screen and (max-width: 767px) {
    .cards-stack-card__number {
      font-size: 2.25em;
    }

    .cards-stack__item.is--wide {
      max-width: 25em;
      top: 1em;
    }

    .cards-stack-card {
      font-size: 0.8em;
      padding: 1rem;
    }

    .cards-stack-card.is--wide {
      aspect-ratio: 7 / 3;
    }

    .cards-stack-card__h.is--wide {
      font-size: 3.375em;
    }

    .container {
      margin-left: auto;
      margin-right: auto;
      padding-left: 1em;
      padding-right: 1em;
    }
  }
</style>
